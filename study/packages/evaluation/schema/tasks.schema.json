{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tui-bench.local/schema/tasks.schema.json",
  "title": "TUI-Bench tasks.json (human metadata only)",
  "type": "object",
  "properties": {
    "project_id": { "type": "string" },
    "slug": { "type": "string" },
    "repo": { "type": "string" },
    "lang": { "type": "string" },
    "description": { "type": "string" },
    "docker_image": { "type": "string" },
    "run_cmd": { "type": "string" },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "required": ["project_id", "slug", "tasks"],
  "$defs": {
    "task": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^T[0-9]{2}$" },
        "description": { "type": "string" },
        "observation": {
          "type": "string",
          "enum": ["filesystem", "screen", "answer"],
          "description": "English-only text：English-only text / English-only text / Agent English-only text"
        },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "type": {
          "type": "string",
          "description": "English-only text：navigate | create | edit | delete"
        },
        "review_notes": {
          "type": "object",
          "properties": {
            "reviewer": { "type": "string" },
            "status": { "type": "string" },
            "issue": { "type": "string" }
          }
        }
      },
      "required": ["id", "description", "observation"]
    }
  }
}
